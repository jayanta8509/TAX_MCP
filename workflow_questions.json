{
  "tasks": [
    {
      "task_id": 1,
      "task_name": "REQUEST & RECEIVE INFORMATION",
      "subtasks": [
        {
          "subtask_id": 1,
          "subtask_name": "Personal Information",
          "questions": [
            {
              "question_id": "1.1",
              "question_text": "Can you confirm your full legal name?",
              "field_name": "full_legal_name",
              "data_type": "string",
              "required": true,
              "skip_if_exists": true,
              "mcp_read_tool": "get_client_full_legal_name",
              "mcp_update_tool": "update_client_full_legal_name",
              "validation": "non_empty"
            },
            {
              "question_id": "1.2",
              "question_text": "Please provide your date of birth.",
              "field_name": "date_of_birth",
              "data_type": "date",
              "required": true,
              "skip_if_exists": true,
              "mcp_read_tool": "get_client_date_of_birth",
              "mcp_update_tool": "update_client_date_of_birth",
              "validation": "valid_date"
            },
            {
              "question_id": "1.3",
              "question_text": "What is your current U.S. address?",
              "field_name": "us_address",
              "data_type": "string",
              "required": true,
              "skip_if_exists": false,
              "mcp_read_tool": "get_client_current_us_address",
              "mcp_update_tool": "update_client_current_us_address",
              "validation": "non_empty"
            },
            {
              "question_id": "1.4",
              "question_text": "Has your country of residence changed from last year?",
              "field_name": "country_changed",
              "data_type": "boolean",
              "required": true,
              "skip_if_exists": false,
              "mcp_read_tool": "get_individual_residency_and_citizenship",
              "condition": "previous_year_exists"
            },
            {
              "question_id": "1.5",
              "question_text": "Please share your updated country of residence.",
              "field_name": "country_of_residence",
              "data_type": "string",
              "required": true,
              "skip_if_exists": false,
              "mcp_read_tool": "get_individual_residency_and_citizenship",
              "mcp_update_tool": "update_individual_identity_and_tax_id",
              "condition": "answer_1.4_is_yes",
              "validation": "non_empty"
            },
            {
              "question_id": "1.6",
              "question_text": "What is your current occupation or source of U.S. income?",
              "field_name": "occupation",
              "data_type": "string",
              "required": true,
              "skip_if_exists": false,
              "mcp_read_tool": "get_client_occupation_and_us_income_source",
              "mcp_update_tool": "update_client_occupation_and_us_income_source",
              "validation": "non_empty"
            }
          ]
        },
        {
          "subtask_id": 2,
          "subtask_name": "ITIN / Identification",
          "questions": [
            {
              "question_id": "2.1",
              "question_text": "Do you have an ITIN number?",
              "field_name": "itin",
              "data_type": "string",
              "required": true,
              "skip_if_exists": false,
              "mcp_read_tool": "get_client_itin_number",
              "mcp_update_tool": "update_client_itin_number",
              "validation": "non_empty"
            },
            
            {
              "question_id": "2.4",
              "question_text": "You'll need to apply for ITIN. Please upload FORM W7.",
              "field_name": "w7_form_uploaded",
              "data_type": "boolean",
              "required": true,
              "skip_if_exists": false,
              "condition": "no_valid_itin"
            }
          ]
        }
      ]
    }
  ]
}